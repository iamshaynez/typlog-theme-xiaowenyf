{# 注意：serve-theme 只内联一层 include，此文件内不能再 include #}
{% set primary = site.primary_links or [] %}
{% set secondary = site.secondary_links or [] %}
{# 顶栏默认露出的主链数量（其余进「更多」） #}
{% set nav_visible_max = 4 %}
{% set has_overflow = (primary|length > nav_visible_max) or (secondary|length > 0) %}
{% set nav_count = (primary|length) + (secondary|length) + (1 if features.algolia else 0) %}

<div class="reading-progress" aria-hidden="true"></div>
<header class="site-header{% if has_overflow %} site-header--hybrid{% endif %}">
  <div class="site-header__inner">
    <a class="site-brand" href="{{ linkify('/') }}" aria-label="{{ site.name }}">
      <span class="site-brand__mark" aria-hidden="true">{{ brand_mark }}</span>
      <span class="site-brand__text">{{ site.name }}</span>
    </a>

    <button class="nav-toggle" type="button" aria-label="打开菜单" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>

    <nav class="site-nav" id="site-nav" aria-label="主导航">
      <ul class="site-nav__list">
        {% if not primary %}
          <li>
            <a class="site-nav__link" href="{{ linkify('/') }}">首页</a>
          </li>
        {% endif %}

        {# 顶栏默认展示的主链 #}
        {% for link in primary %}
          {% if loop.index <= nav_visible_max %}
            <li>
              <a class="site-nav__link" href="{{ link.url }}"{% if link.blank %} target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ link.title }}
              </a>
            </li>
          {% endif %}
        {% endfor %}

        {# 溢出：更多主链 + secondary #}
        {% if has_overflow %}
          <li class="site-nav__more">
            <button
              type="button"
              class="site-nav__link site-nav__more-btn"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="nav-more-menu"
              id="nav-more-btn"
            >
              更多
              <span class="site-nav__more-caret" aria-hidden="true"></span>
            </button>
            <ul class="site-nav__dropdown" id="nav-more-menu" role="menu" hidden>
              {% for link in primary %}
                {% if loop.index > nav_visible_max %}
                  <li role="none">
                    <a class="site-nav__dropdown-link" role="menuitem" href="{{ link.url }}"{% if link.blank %} target="_blank" rel="noopener noreferrer"{% endif %}>
                      {{ link.title }}
                    </a>
                  </li>
                {% endif %}
              {% endfor %}
              {% if primary|length > nav_visible_max and secondary|length > 0 %}
                <li class="site-nav__dropdown-sep" role="separator" aria-hidden="true"></li>
              {% endif %}
              {% for link in secondary %}
                <li role="none">
                  <a class="site-nav__dropdown-link site-nav__dropdown-link--secondary" role="menuitem" href="{{ link.url }}"{% if link.blank %} target="_blank" rel="noopener noreferrer"{% endif %}>
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          </li>
        {% endif %}

        {% if features.algolia %}
          <li>
            <button type="button" class="site-nav__link js-search" aria-label="搜索">搜索</button>
          </li>
        {% endif %}
      </ul>
    </nav>
  </div>
</header>
<main class="site-main" id="main">
