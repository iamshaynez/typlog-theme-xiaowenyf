{#
  文章卡片宏
  style: featured | plain | list
  index: 显示编号（可选）
#}

{% macro render_post_card(post, style='plain', index=none) %}
  {% if style == 'list' %}
    <article class="post-card post-card--list">
      {% if index is not none %}
        <div class="post-card__index" aria-hidden="true">{{ '%02d'|format(index) }}</div>
      {% endif %}
      <div class="post-card__body">
        {% if post.tags and post.tags|length > 0 %}
          <div class="post-card__cat">{{ post.tags[0].title }}</div>
        {% elif post.type %}
          <div class="post-card__cat">{{ '播客' if post.type == 'audio' else '文章' }}</div>
        {% endif %}
        <h3 class="post-card__title">
          <a class="post-card__title-link" href="{{ linkify(post.url) }}">{{ post.title }}</a>
        </h3>
        {% if post.subtitle %}
          <p class="post-card__excerpt">{{ post.subtitle }}</p>
        {% endif %}
        <div class="post-card__meta">
          {% if post.published_at %}
            <time datetime="{{ post.published_at|xmldatetime }}">{{ post.published_at.strftime('%Y.%m.%d') }}</time>
          {% endif %}
        </div>
      </div>
    </article>

  {% elif style == 'featured' %}
    <article class="post-card post-card--featured">
      {% if index is not none %}
        <div class="post-card__index" aria-hidden="true">{{ '%02d'|format(index) }}</div>
      {% endif %}
      <div class="post-card__body">
        {% if post.tags and post.tags|length > 0 %}
          <div class="post-card__cat">{{ post.tags[0].title }}</div>
        {% else %}
          <div class="post-card__cat">特稿</div>
        {% endif %}
        <h2 class="post-card__title">
          <a class="post-card__title-link" href="{{ linkify(post.url) }}">{{ post.title }}</a>
        </h2>
        {% if post.subtitle %}
          <p class="post-card__excerpt">{{ post.subtitle }}</p>
        {% endif %}
        <div class="post-card__meta">
          {% if post.published_at %}
            <time datetime="{{ post.published_at|xmldatetime }}">{{ post.published_at.strftime('%Y.%m.%d') }}</time>
          {% endif %}
        </div>
      </div>
    </article>

  {% else %}
    <article class="post-card post-card--plain">
      {% if post.cover and post.cover.src %}
        <a class="post-card__media" href="{{ linkify(post.url) }}" tabindex="-1" aria-hidden="true">
          <img src="{{ post.cover.src|thumbnail('m') }}" alt="" loading="lazy">
        </a>
      {% endif %}
      <div class="post-card__body">
        {% if post.tags and post.tags|length > 0 %}
          <div class="post-card__cat">{{ post.tags[0].title }}</div>
        {% endif %}
        <h3 class="post-card__title">
          <a class="post-card__title-link" href="{{ linkify(post.url) }}">{{ post.title }}</a>
        </h3>
        {% if post.subtitle %}
          <p class="post-card__excerpt">{{ post.subtitle }}</p>
        {% endif %}
        <div class="post-card__meta">
          {% if post.published_at %}
            <time datetime="{{ post.published_at|xmldatetime }}">{{ post.published_at.strftime('%Y.%m.%d') }}</time>
          {% endif %}
          {% if post.tags and post.tags|length > 0 %}
            <span class="dot" aria-hidden="true"></span>
            <span>{{ post.tags[0].title }}</span>
          {% endif %}
        </div>
      </div>
    </article>
  {% endif %}
{% endmacro %}
