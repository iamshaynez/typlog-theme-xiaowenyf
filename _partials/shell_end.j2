{# 注意：serve-theme 只内联一层 include，此文件内不能再 include #}
</main>

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div>
        <div class="site-footer__brand">{{ site.name }}</div>
        <p class="site-footer__desc">{{ footer_desc }}</p>
      </div>

      <div>
        <div class="site-footer__col-title">导航</div>
        <ul class="site-footer__links">
          <li><a href="{{ linkify('/') }}">首页</a></li>
          {% if site.primary_links %}
            {% for link in site.primary_links %}
              <li>
                <a href="{{ link.url }}"{% if link.blank %} target="_blank" rel="noopener noreferrer"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          {% elif archive_url %}
            <li><a href="{{ linkify(archive_url) }}">文章</a></li>
          {% endif %}
          {% if site.secondary_links %}
            {% for link in site.secondary_links %}
              <li>
                <a href="{{ link.url }}"{% if link.blank %} target="_blank" rel="noopener noreferrer"{% endif %}>
                  {{ link.title }}
                </a>
              </li>
            {% endfor %}
          {% endif %}
        </ul>
      </div>

      <div>
        <div class="site-footer__col-title">社交</div>
        <ul class="site-footer__links">
          <li><a href="{{ linkify('/feed.xml') }}">RSS</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>
        © {{ site.name }}
        {% if site.license %} · {{ site.license }}{% endif %}
      </span>
      <span>
        以 <span class="site-footer__red">冷漆红</span> 点睛 · 玄墨主题
      </span>
    </div>
  </div>
</footer>

<button class="back-top" type="button" aria-label="返回顶部" title="返回顶部">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7"/>
  </svg>
</button>
